*.pt filter=lfs diff=lfs merge=lfs -text
*.pth filter=lfs diff=lfs merge=lfs -text
*.onnx filter=lfs diff=lfs merge=lfs -text
*.torchscript filter=lfs diff=lfs merge=lfs -text

# Published evidence is byte-hashed, so Git must not rewrite LF/CRLF on checkout.
reports/progress/** -text
reports/progress/** -whitespace

# Published logs also preserve the trainer's original spacing as evidence.
reports/progress/**/*.log -whitespace

# Generated methodology files contain byte hashes; preserve their committed bytes on every OS.
reports/methodology/*.md -text
reports/methodology/*.json -text
reports/methodology/*.csv -text
reports/methodology/*.yaml -text

# Hash-bound public release trees must retain exact bytes across autocrlf checkouts.
reports/comparisons/** -text
reports/runs/** -text
reports/deployments/** -text
weights/trained/** -text
